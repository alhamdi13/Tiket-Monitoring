# ─────────────────────────────────────────────────────────────────────────────
# Flight Price Monitor — Konfigurasi (.env)
#
# Salin file ini menjadi .env lalu isi nilai-nilainya
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Buat bot di @BotFather → /newbot → salin token-nya ke sini
TELEGRAM_BOT_TOKEN=8784730971:AAH1UXfl_0gTxbplXhTCizhJJpZY9WDHeWw

# Chat ID kamu — dapatkan dari @userinfobot (kirim /start ke bot tsb)
TELEGRAM_CHAT_ID=5217528489

# ── Rute Penerbangan ──────────────────────────────────────────────────────────
# Kode IATA bandara (3 huruf kapital)
# Contoh: CGK=Soekarno-Hatta, DPS=Ngurah Rai, SUB=Juanda, MLG=Abdul Rachman Saleh
FLIGHT_ORIGIN=SUB
FLIGHT_DESTINATION=BDJ

# Label tampilan (opsional, akan otomatis dibuat jika kosong)
FLIGHT_LABEL=Surabaya → Banjarmasin

# ── Batas Harga ───────────────────────────────────────────────────────────────
# Kirim notifikasi jika harga tiket DI BAWAH angka ini (dalam Rupiah)
MAX_PRICE_IDR=1800000

# ── Rentang Tanggal ───────────────────────────────────────────────────────────
# Cek tiket untuk berapa hari ke depan?
DAYS_AHEAD=4

# ── Jadwal Pengecekan ─────────────────────────────────────────────────────────
# Cek harga setiap berapa jam? (rekomendasi: 4-8 jam)
CHECK_INTERVAL_HOURS=1

# ── Logging ───────────────────────────────────────────────────────────────────
# Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
